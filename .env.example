# Flask Secret Key - Generate a secure random key
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-this-to-random-value

# Database URL - Railway will automatically set this for you
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@hostname:5432/railway

# Optional: Set to 'production' in production
FLASK_ENV=production
